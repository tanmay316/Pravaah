rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // All writes go through the API (Admin SDK, which bypasses these rules). Clients may
    // only read their own data: a client write could otherwise set plan, role or
    // premium_until on the user document and grant itself Premium or admin access.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;

      match /{subcollection=**} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }
    }

    // Coupons, usage, error logs, bug reports and admin config are server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
