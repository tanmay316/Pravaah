# ============================================================
# Pravaah (प्रवाह) AI English Coach — Environment Variables
# ============================================================
# Copy this file to .env in the root and in each service folder as needed:
#   cp .env.example .env
#   cp .env.example services/api/.env
#   cp .env.example services/learning-engine/.env
#   cp .env.example services/voice-agent/.env
#   cp .env.example apps/expo/.env
#
# NOTE: NEVER commit actual .env files containing real secret keys to git.
# ============================================================

# --- 1. Frontend: Expo / React Native (Public Client Keys) ---
# These are read at BUILD time. For the web build they must exist in apps/expo/.env
# before you run `npm run build:web`, or the app ships without auth and without an API.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
# Must be the full https URL of the deployed backend, e.g. https://pravaah-backend.onrender.com
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_LIVEKIT_URL=wss://your-subdomain.livekit.cloud

# --- 2. Backend: Firebase Admin Service Account ---
# Absolute or relative path to your downloaded Firebase Service Account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=../../secrets/firebase-service-account.json

# --- 3. LiveKit Cloud (WebRTC Realtime Voice Transport) ---
LIVEKIT_URL=wss://your-subdomain.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# --- 4. LLM & Speech AI Provider Keys ---
# Google Gemini
GEMINI_API_KEY=AIzaSy...

# Groq (Ultra-low latency STT - whisper-large-v3-turbo, and the conversation LLM)
GROQ_API_KEY=gsk_...

# OpenRouter (Fallback LLM - optional)
OPENROUTER_API_KEY=sk-or-v1-...

# NVIDIA NIM (Fallback LLM - optional)
NVIDIA_API_KEY=nvapi-...

# --- 5. Model Routing & Proxy ---
REALTIME_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
FALLBACK_MODEL=gemini-2.5-flash
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-pravaah-dev-key

# --- Voice teaching & recognition ---
# Whisper accuracy drops when it also has to guess the language, so sessions pin
# English unless the learner picks Hindi or Auto. No Whisper `prompt` is sent:
# that field is decoding context and rewrites what the learner actually said.
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_HINDI_MODEL=whisper-large-v3
# Turn-taking. Raise the silence/endpointing values if turns are being cut off
# mid-sentence (which makes Whisper guess the ending); lower them for snappier replies.
VAD_ACTIVATION_THRESHOLD=0.55
VAD_MIN_SILENCE=0.60
MIN_ENDPOINTING_DELAY=0.40
MAX_ENDPOINTING_DELAY=1.20
# Coach voice. Learners pick this in Profile; TTS_VOICE_DEFAULT sets the fallback for
# accounts that never chose one. TTS_VOICE/GROQ_TTS_VOICE force one voice for everybody.
TTS_VOICE_DEFAULT=indian_female
# Visual cards are optional; the main voice model always teaches and corrects.
# Disable cards to reduce provider requests on tight free-tier quotas.
VOICE_CARDS_ENABLED=true
GROQ_FAST_MODEL=llama-3.1-8b-instant

# --- 6. TTS Configuration ---
# Primary: OpenAI-compatible /v1/audio/speech endpoint the voice agent calls.
# The Pravaah API serves one at <API_URL>/v1. Point this at a host that is NOT
# competing with the agent for CPU.
TTS_BASE_URL=http://localhost:8880/v1
# Leave TTS_VOICE and GROQ_TTS_VOICE unset so each learner's Profile choice applies.
# Set them only to force a single voice for every account.
# TTS_VOICE=en-IN-NeerjaNeural
# Fallback: Groq hosted TTS, used automatically if the primary endpoint fails.
# Requires GROQ_API_KEY.
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
# GROQ_TTS_VOICE=autumn
# Last resort is the learner's own device voice (expo-speech), which needs no config:
# if a coach turn arrives with no audio behind it, the app reads it aloud locally.

# --- 7. Deployment topology ---
# Co-host the realtime voice agent inside the API container. Only enable on a host
# with >= 1 vCPU and >= 1GB RAM; on a 0.1-vCPU free instance the agent starves and
# audio stops ("job executor is unresponsive" in the logs).
RUN_VOICE_AGENT=false
# Job isolation for the agent worker: "process" (default, recommended) or "thread".
JOB_EXECUTOR=process
# Accept unauthenticated "demo_*" bearer tokens. NEVER enable in production.
ALLOW_DEMO_AUTH=false
# Let the voice agent write transcripts itself (pulls in the learning engine). The API
# already persists and analyses the transcript on session end, so leave this off.
PRAVAAH_AGENT_PERSISTENCE=false
