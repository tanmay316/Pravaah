rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Users — only the authenticated owner can read/write their data
    // ---------------------------------------------------------------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;

        // Messages nested under sessions
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == uid;
        }
      }

      // Mistakes subcollection
      match /mistakes/{mistakeId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Vocabulary subcollection
      match /vocabulary/{vocabularyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // Daily stats subcollection
      match /dailyStats/{date} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
