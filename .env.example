# ============================================================
# Pravaah (प्रवाह) AI English Coach — Environment Variables
# ============================================================
# Copy this file to .env in the root and in each service folder as needed:
#   cp .env.example .env
#   cp .env.example services/api/.env
#   cp .env.example services/learning-engine/.env
#   cp .env.example services/voice-agent/.env
#   cp .env.example apps/expo/.env
#
# NOTE: NEVER commit actual .env files containing real secret keys to git.
# ============================================================

# --- 1. Frontend: Expo / React Native (Public Client Keys) ---
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSy...
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_API_URL=http://localhost:8000

# --- 2. Backend: Firebase Admin Service Account ---
# Absolute or relative path to your downloaded Firebase Service Account JSON
FIREBASE_SERVICE_ACCOUNT_PATH=../../secrets/firebase-service-account.json

# --- 3. LiveKit Cloud (WebRTC Realtime Voice Transport) ---
LIVEKIT_URL=wss://your-subdomain.livekit.cloud
LIVEKIT_API_KEY=API...
LIVEKIT_API_SECRET=...

# --- 4. LLM & Speech AI Provider Keys ---
# Google Gemini (Primary LLM - gemini-3.5-flash-lite / gemini-2.5-flash)
GEMINI_API_KEY=AIzaSy...

# Groq (Ultra-low latency STT - whisper-large-v3-turbo)
GROQ_API_KEY=gsk_...

# OpenRouter (Fallback LLM - optional)
OPENROUTER_API_KEY=sk-or-v1-...

# NVIDIA NIM (Fallback LLM - optional)
NVIDIA_API_KEY=nvapi-...

# --- 5. Model Routing & Proxy ---
REALTIME_MODEL=gemini-3.5-flash-lite
FALLBACK_MODEL=gemini-2.5-flash
LITELLM_PROXY_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-pravaah-dev-key

# --- 6. TTS Configuration ---
# Options: "kokoro" (uses local fast neural TTS endpoint) or "google"
TTS_PROVIDER=kokoro
KOKORO_BASE_URL=http://localhost:8880/v1
KOKORO_VOICE=en-IN-NeerjaNeural
